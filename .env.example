# Copy this file to .env and set the values you need.

# Database connection (optional, defaults to data/recipe_drawer.db under the project root)
# DATABASE_URL=sqlite:///path/to/recipe_drawer.db

# User agent sent when fetching robots.txt and recipe pages (optional)
# USER_AGENT="RecipeDrawer/1.0 (self-hosted recipe manager)"

# Timeout in seconds for fetching web pages and robots.txt (optional)
# FETCH_TIMEOUT_SECONDS=20